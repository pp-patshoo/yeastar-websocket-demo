{
  "name": "yeastar-websocket-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yeastar P-Series WebSocket Audio Streaming demo: live dashboard, live listen and Deepgram live transcription",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "mock-pbx": "tsx tools/mock-pbx.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock-yeastar-api": "tsx tools/mock-yeastar-api.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
