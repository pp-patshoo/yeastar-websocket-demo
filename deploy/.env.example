# ===== Yeastar Audio Monitor — ค่าสำหรับ docker compose =====
# คัดลอกเป็น .env ที่โฟลเดอร์หลักของโปรเจกต์:  cp deploy/.env.example .env

# IP ของ VM ที่ PBX ใช้เชื่อมเข้ามา (ต้องตั้ง — ใน container แอปหา IP ของ VM เองไม่ได้)
PUBLIC_HOST=192.168.1.50

# พอร์ตบน VM: หน้าเว็บ (LAN) และพอร์ตที่ PBX ส่งเสียงเข้ามา
HTTP_PORT=80
PBX_PORT=8080

# login หน้า Dashboard — ตั้งด้วยคำสั่ง ./deploy/set-password.sh
# (ถ้าแก้เอง: ค่า hash ต้องอยู่ในเครื่องหมาย ' ' เพราะมีตัว $)
DASH_USER=admin
DASH_PASS_HASH=

# ค่าเริ่มต้นตอนยังไม่มี data/settings.json (แก้ภายหลังได้จากหน้าเว็บ)
STT_ENABLED=false
STT_MODEL=nova-3
STT_LANGUAGE=th
DEEPGRAM_API_KEY=

# กู้คืน: ถ้าปิด "Dashboard ผ่าน LAN" แล้วเข้าไม่ได้ ให้ตั้งเป็น 1 แล้วรัน docker compose up -d
FORCE_LAN_DASHBOARD=0
